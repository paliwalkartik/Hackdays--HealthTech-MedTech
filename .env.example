# Intelli-Vitals Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server settings
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:8501

# Camera settings
CAMERA_INDEX=0
# Options: "auto" | "dshow" | "v4l2" | "avfoundation"
CAMERA_BACKEND=auto
# Set to 1 to disable capture thread (for headless CI / testing)
IV_DISABLE_CAMERA=0

# Gemini AI settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Clinical and vitals processing settings
MEASURE_SECONDS=60
WINDOW_SECONDS=10
MAX_UPLOAD_MB=10

# Database settings
DB_PATH=health_data.db
SESSION_TTL_DAYS=30

# API Security Token (auto-generated per process by run.py; set here only for separate manual runs)
IV_API_TOKEN=

# Development / Testing Auth Bypass
# Set to 1 to bypass Google OAuth login for local development / testing without credentials
IV_DEV_LOGIN=0

# Polling Loop Control
# Set to 1 to limit continuous polling to a single iteration (for testing)
IV_DISABLE_POLLING=0
