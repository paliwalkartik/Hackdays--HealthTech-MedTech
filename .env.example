# Intelli-Vitals Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server settings
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:8501

# Camera settings
CAMERA_INDEX=0
CAMERA_BACKEND=auto  # "auto" | "dshow" | "v4l2" | "avfoundation"
IV_DISABLE_CAMERA=0  # Set to 1 to disable capture thread (for headless CI / testing)

# Gemini AI settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Clinical and vitals processing settings
MEASURE_SECONDS=60
WINDOW_SECONDS=10
MAX_UPLOAD_MB=10

# Database settings
DB_PATH=health_data.db
SESSION_TTL_DAYS=30

# Development / Testing Auth Bypass
# Set to 1 to bypass Google OAuth login for local development / testing without credentials
IV_DEV_LOGIN=0
