# Intelli-Vitals Environment Configuration
# Copy this file to .env and fill in your values.

# Gemini API Key (required for /consult and /analyze_report)
GEMINI_API_KEY=

# Set to 1 or true to disable webcam capture thread (useful for headless testing or CI)
IV_DISABLE_CAMERA=0

# OAuth transport security (set to 1 to allow HTTP in local development)
OAUTHLIB_INSECURE_TRANSPORT=1

# Optional session secret for cookie signing (defaults to built-in key if unset)
COOKIE_SECRET=

