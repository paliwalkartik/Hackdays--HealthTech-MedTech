# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and supply your credentials.

# Gemini API Key (alternative to environment variable)
GEMINI_API_KEY = "your-gemini-api-key-here"

# Secret HMAC key for session cookies
COOKIE_SECRET = "your-random-cookie-secret-key-here"

[google_oauth]
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
redirect_uri = "http://localhost:8501"

